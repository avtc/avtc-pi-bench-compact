{
  "name": "avtc-pi-bench-compact",
  "version": "0.0.0",
  "description": "Benchmarks compaction/memory approaches (arms) on an identical authored workload: samples post-compaction agent behavior over N runs and scores effectiveness + cost via a calibrated LLM judge + exact trace signals.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "main": "./index.ts",
  "types": "./index.ts",
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "allowedCodeDeps": [
      "avtc-pi-settings-ui"
    ]
  },
  "files": [
    "index.ts",
    "src/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc.tsbuildinfo",
    "knip": "knip --production",
    "dupes": "jscpd src/ --exit-code --threshold 0.01",
    "test": "biome check . && tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc.tsbuildinfo && knip --production && npm run dupes && vitest run"
  },
  "dependencies": {
    "avtc-pi-settings-ui": "^1.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/node": "^25.9.3",
    "jscpd": "^5.0.10",
    "knip": "^6.17.1",
    "typebox": "^1.1.38",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "author": "avtc <tarasenkov@gmail.com>"
}
